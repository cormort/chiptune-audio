{
  "name": "chiptune-audio",
  "version": "0.2.0",
  "description": "Zero-dependency 8-bit sound effect and music engine for browser games (Web Audio).",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "chiptune": "bin/chiptune.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "bin",
    "types",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:direct": "node test/all.js",
    "bench": "node test/bench.js src",
    "bench:baseline": "node test/bench.js baseline",
    "probe": "node test/defects.probe.js src",
    "serve": "npx serve ."
  },
  "keywords": [
    "chiptune",
    "8-bit",
    "8bit",
    "retro",
    "game-audio",
    "sfx",
    "sound-effects",
    "procedural-music",
    "web-audio",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
